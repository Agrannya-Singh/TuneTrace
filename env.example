# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spotify API Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:9002/api/spotify/callback

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Python Backend Configuration (for ML recommendations)
PYTHON_BACKEND_URL=http://localhost:8000
ML_MODEL_PATH=./ml_models/recommendation_model.pkl
DATABASE_URL=sqlite:///./tunetrace.db

# Optional: For production deployment
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@localhost:5432/tunetrace 