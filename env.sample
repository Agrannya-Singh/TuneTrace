GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=

# Set this to the canonical URL of your site.
# For local development, this is typically http://localhost:3000
# For production, it will be one of your deployment URLs.
# e.g., NEXTAUTH_URL=https://tune-trace-rubp.vercel.app
NEXTAUTH_URL=

